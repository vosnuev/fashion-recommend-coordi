# ============================================================
# 환경변수 템플릿. 복사해서 사용: cp .env.example .env
# 실제 .env는 절대 커밋하지 않는다 (.gitignore 처리됨).
# ============================================================

# ---------- PostgreSQL (공통) ----------
POSTGRES_DB=fashion_db
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change-me
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
# 컨테이너 db의 호스트 공개 포트. 로컬 PostgreSQL과 충돌 시 다른 값으로 변경 (예: 15432)
POSTGRES_HOST_PORT=5432
# DATABASE_URL을 쓰면 위 개별 값 대신 우선 적용된다.
# DATABASE_URL=postgresql://postgres:change-me@localhost:5432/fashion_db

# ---------- 네이버 오픈 API (collector/naver) ----------
# https://developers.naver.com 에서 애플리케이션 등록 후 발급
NAVER_CLIENT_ID=
NAVER_CLIENT_SECRET=
# 검색 옵션
NAVER_SORT=sim                       # sim | date | asc | dsc
NAVER_EXCLUDE=used:rental:cbshop     # 중고/렌탈/해외직구 제외
NAVER_MAX_ITEMS_PER_KEYWORD=300      # 키워드당 수집 상한 (API 한계: 1100)
NAVER_DISPLAY=100                    # 요청당 결과 수 (API 최대: 100)
NAVER_MAX_START=1000                 # start 파라미터 상한 (API 제한: 1000)
NAVER_REQUEST_INTERVAL_SECONDS=0.15
# 키워드 성별 확장. 예: "남성,여성" → "남성 반팔 티셔츠" 등으로 확장 수집
NAVER_KEYWORD_GENDER_PREFIXES=

# ---------- LLM 태깅 (collector/naver, collector/eleven → collector/util/tagging) ----------
# 태깅 provider: openai | claude
#   openai - OpenAI API (sync/batch 지원)
#   claude - Claude Agent SDK. 구독제(Pro/Max) 계정의 OAuth 토큰 사용, sync 전용
NAVER_TAGGING_PROVIDER=openai

# openai provider
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# claude provider — `claude setup-token`으로 발급한 구독 계정 OAuth 토큰
CLAUDE_CODE_OAUTH_TOKEN=
# OAuth 대신 Anthropic API 종량 과금을 사용할 때 설정
ANTHROPIC_API_KEY=
# 빈 값이면 Claude Code CLI 기본 모델 사용 (예: claude-haiku-4-5)
NAVER_CLAUDE_MODEL=
# Docker에서 claude provider 사용 시 true (이미지 빌드에 Claude Code CLI 포함)
INSTALL_CLAUDE_CLI=false
# batch(기본): Batch API로 태깅 (50% 할인, 완료까지 최대 24h) / sync: 실시간 태깅
NAVER_TAGGING_MODE=batch
NAVER_BATCH_MAX_REQUESTS=10000
NAVER_BATCH_POLL_SECONDS=600
NAVER_BATCH_COMPLETION_WINDOW=24h
# 배치 요청에 상품 이미지 포함 여부 (gpt-4o-mini는 이미지 토큰 과금이 커서 기본 false)
NAVER_BATCH_INCLUDE_IMAGE=false
# sync 모드 전용 — auto: 텍스트 태깅 부실 시 이미지 포함 재시도 / always / never
NAVER_LLM_IMAGE_MODE=auto
NAVER_LLM_TEMPERATURE=0.1
NAVER_LLM_MAX_RETRIES=2

# ---------- 네이버 collector 스케줄 (매일 KST) ----------
NAVER_SCHEDULE_HOUR=3
NAVER_SCHEDULE_MINUTE=0

# ---------- 11번가 ProductSearch API (collector/eleven) ----------
11ST_API_KEY=
ELEVEN_PRODUCT_SEARCH_URL=http://openapi.11st.co.kr/openapi/OpenApiService.tmall
ELEVEN_CATEGORY_API_URL=http://api.11st.co.kr/rest/cateservice/category
ELEVEN_SEARCH_SORT=N
ELEVEN_PAGE_SIZE=50
ELEVEN_MAX_ITEMS_PER_KEYWORD=50
# scheduler 1회 실행에서 DB에 새로 저장할 상품의 전체 상한
ELEVEN_DAILY_MAX_ITEMS=1000
ELEVEN_REQUEST_INTERVAL_SECONDS=0.2
ELEVEN_KEYWORD_GENDER_PREFIXES=
ELEVEN_CATEGORY_MAPPING_VERSION=2026-07-21-v1
# 전체 카테고리 동기화에서 연속 누락 후 is_active=false 처리하는 횟수
ELEVEN_CATEGORY_INACTIVE_MISS_THRESHOLD=3
# 11번가 태깅 provider: openai | claude
ELEVEN_TAGGING_PROVIDER=openai
# openai: batch(기본) 또는 sync / claude: sync로 자동 전환
ELEVEN_TAGGING_MODE=batch
ELEVEN_BATCH_MAX_REQUESTS=10000
ELEVEN_BATCH_POLL_SECONDS=600
ELEVEN_BATCH_COMPLETION_WINDOW=24h
# Batch 요청에 상품 이미지를 고정 포함할지 여부
ELEVEN_BATCH_INCLUDE_IMAGE=false
# Claude provider 전용. 빈 값이면 Claude Code CLI 기본 모델 사용.
ELEVEN_CLAUDE_MODEL=
# sync 모드의 OpenAI 이미지 재시도 설정
ELEVEN_LLM_IMAGE_MODE=auto
ELEVEN_LLM_TEMPERATURE=0.1
ELEVEN_LLM_MAX_RETRIES=2
ELEVEN_SCHEDULE_HOUR=4
ELEVEN_SCHEDULE_MINUTE=0

# ---------- Docker Compose ----------
# 루트 docker-compose.yml에서 띄울 스택 선택 (--profile 플래그 대신 사용 가능)
# 예: db,api / api,naver / all
COMPOSE_PROFILES=api

# ---------- Django API 서버 (api/) ----------
DJANGO_SECRET_KEY=change-me-generate-a-random-50-char-string
# API 실행 모드 (docker-compose.yml의 api/migrate 서비스가 사용). 허용 값:
#   config.settings.prod           운영 기본값 (HTTPS 리다이렉트 활성)
#   config.settings.dev            로컬 http 개발
#   config.settings.swagger        dev + Swagger UI (/api/docs/)
DJANGO_SETTINGS_MODULE=config.settings.prod
# prod 필수. 콤마 구분: api.example.com,internal.example.com
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
# 로컬 도커(http) 테스트 시 false. AWS(ALB+HTTPS) 배포 시 true.
DJANGO_SECURE_SSL_REDIRECT=false
GUNICORN_WORKERS=3
# ---- API 로깅 (api/gunicorn.conf.py + config/settings/base.py) ----
# 요청 단위 액세스 로그는 gunicorn이, 애플리케이션 로그는 Django LOGGING이 남긴다.
# 둘 다 컨테이너 stdout으로 나가므로 `docker compose logs -f api`로 확인한다.
GUNICORN_LOG_LEVEL=info
# 동기 가상 착장 요청을 포함하므로 이미지 모델 제한보다 길게 둔다.
GUNICORN_TIMEOUT=660
# 프록시(Cloudflare tunnel / ALB) 뒤의 X-Forwarded-For를 신뢰할 IP.
# 컨테이너 네트워크에서는 프록시가 127.0.0.1이 아니므로, 신뢰 가능한 프록시
# 뒤에서만 * 로 연다. 열지 않아도 액세스 로그의 xff= 필드에 원본 헤더는 남는다.
GUNICORN_FORWARDED_ALLOW_IPS=127.0.0.1
# 액세스 로그에서 제외할 경로 정규식 (콤마 구분). 예: /health,/api/docs
GUNICORN_ACCESS_LOG_SKIP=
# apps.* 로거 레벨은 아래 공통 LOG_LEVEL을 따른다. django 프레임워크 로그는 별도.
DJANGO_LOG_LEVEL=INFO
# 4xx/5xx 응답 로그. 400/404까지 보려면 WARNING (기본), 에러만 보려면 ERROR.
DJANGO_REQUEST_LOG_LEVEL=WARNING
# SQL 쿼리 로그. 디버깅할 때만 DEBUG.
DJANGO_DB_LOG_LEVEL=WARNING
JWT_ACCESS_MINUTES=30
JWT_REFRESH_DAYS=14
# CORS 허용 origin. 콤마 구분, 스킴 포함 origin만 (경로 없음).
# 예: CORS_ALLOWED_ORIGINS=https://skn-1st-mobile.expo.app,http://localhost:19006
CORS_ALLOWED_ORIGINS=
# 게스트 채팅의 HttpOnly 쿠키를 API 요청에 포함하려면 true여야 한다.
CORS_ALLOW_CREDENTIALS=true

# ---------- 소셜 로그인 OAuth (api/apps/users) ----------
# 검색 API용 NAVER_CLIENT_ID와 별개다. 네이버 개발자센터의 "네이버 로그인" 앱 키를 쓴다.
NAVER_OAUTH_CLIENT_ID=
NAVER_OAUTH_CLIENT_SECRET=
# 카카오는 REST API 키 사용. client_secret은 콘솔에서 활성화한 경우에만 설정.
KAKAO_OAUTH_REST_API_KEY=
KAKAO_OAUTH_CLIENT_SECRET=
# token 방식 로그인(네이티브 앱 SDK) 검증용 앱 ID (카카오 콘솔 > 앱 설정 > 요약 정보의 숫자 ID)
KAKAO_APP_ID=
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
# 네이티브 앱 SDK가 받아오는 토큰의 aud는 웹이 아니라 그 플랫폼의 클라이언트 ID다.
# 앱 로그인을 쓰려면 같은 Google Cloud 프로젝트의 iOS/Android 클라이언트 ID도 채운다.
GOOGLE_OAUTH_IOS_CLIENT_ID=
GOOGLE_OAUTH_ANDROID_CLIENT_ID=
# 애플: Apple Developer Console > Certificates, Identifiers & Profiles에서 발급
# APPLE_CLIENT_ID: Services ID (com.example.yourapp)
# APPLE_PRIVATE_KEY: "Sign in with Apple" 키 PEM 전체 내용 (\n을 실제 줄바꿈으로 입력)
APPLE_CLIENT_ID=
APPLE_TEAM_ID=
APPLE_KEY_ID=
APPLE_PRIVATE_KEY=
OAUTH_REQUEST_TIMEOUT=10

# ---------- Qdrant 벡터 DB (api/apps/recommend) ----------
# 로컬 도커: http://localhost:6333 (compose 내부에서는 자동으로 http://qdrant:6333)
QDRANT_URL=http://localhost:6333
# 비우면 무인증(로컬 전용). EC2 등 외부 노출 시 반드시 설정.
QDRANT_API_KEY=
QDRANT_TIMEOUT=10
# 임베딩 차원 (모델 교체 시에만 변경: FashionSigLIP=768, BGE-M3=1024)
QDRANT_IMAGE_VECTOR_DIM=768
QDRANT_TEXT_VECTOR_DIM=1024
# 추천 도메인 공통 컬렉션 계약. 생산자(indexer/wardrobe/goldenset)에도 같은 값을 쓴다.
QDRANT_GOLDEN_OUTFIT_COLLECTION=outfit_goldenset
QDRANT_GOLDEN_ITEM_COLLECTION=goldenset_items
QDRANT_WARDROBE_COLLECTION=wardrobe_items
PRODUCT_NAVER_QDRANT_COLLECTION=products_naver_v1
PRODUCT_ELEVEN_QDRANT_COLLECTION=products_eleven_v1
QDRANT_KNOWLEDGE_COLLECTION=knowledge
# 공유 옷 이미지와 내 옷 이미지의 cosine 유사도 최소 점수 (0~1, 평가 후 조정)
SHARED_REFERENCE_VISUAL_MIN_SCORE=0.75
# 시각 유사 후보가 없을 때 스타일·색상·핏·소재 가중 점수 최소값 (0~1)
SHARED_REFERENCE_STYLE_MIN_SCORE=0.30
# ── 골든셋 텍스트 검색용 BGE-M3 내부 임베딩 엔드포인트 ──
# 채팅이 사용자 문장으로 골든 코디를 찾을 때 쓴다. 서버는 GPU 스택의
# text-embedding-api(docker-compose.gpu.yml)이고, 경로까지 포함한 전체 URL을 적는다.
#   예) http://gpu-host:8081/v1/text-embeddings
# 비워두면 추천이 죽지는 않고 의미 검색 없이 필터 검색으로 내려간다
# (문장의 뉘앙스가 추천에 반영되지 않는다 — 결과의 search_mode가 'filter'로 남는다).
TEXT_EMBEDDING_API_URL=
# API 서버와 임베딩 서버가 **같은 값**을 공유한다. 임의의 긴 난수를 쓸 것.
TEXT_EMBEDDING_API_TOKEN=
TEXT_EMBEDDING_TIMEOUT_SECONDS=15
TEXT_EMBEDDING_EXPECTED_DIM=1024

# ── 임베딩 서버(GPU) 쪽 설정 ──
# 호스트 포트가 겹칠 때만 바꾼다. 컨테이너 안 포트는 compose가 8081로 못 박는다.
TEXT_EMBEDDING_API_HOST_PORT=8081
# ⚠️ 골든셋을 색인한 모델과 **반드시 같아야** 한다(GOLDEN_TEXT_EMBED_MODEL).
#    바꾸면 골든셋을 다시 색인해야 한다 — 안 그러면 검색이 실패하지 않고 조용히
#    엉뚱한 코디를 고른다. 비우면 GOLDEN_TEXT_EMBED_MODEL → BAAI/bge-m3 순으로 쓴다.
TEXT_EMBEDDING_MODEL=
# 추천 결과에 기록되는 임베딩 버전 문자열 (관측용).
TEXT_EMBEDDING_VERSION=bge-m3-v1
# 비우면 INDEXER_DEVICE → auto. GPU 없는 호스트에서 스모크 테스트할 때만 cpu.
TEXT_EMBEDDING_DEVICE=
# 한 요청에서 임베딩할 문장 수 상한. 채팅은 항상 1개를 보낸다.
TEXT_EMBEDDING_MAX_TEXTS=16
QDRANT_COLLECTION=fashion_items
# 신규 네이버·11번가 상품 전용 컬렉션. ETRI PoC fashion_items와 분리한다.
PRODUCT_QDRANT_COLLECTION=products_v1
PRODUCT_IMAGE_EMBED_MODEL=hf-hub:Marqo/marqo-fashionSigLIP
PRODUCT_TEXT_EMBED_MODEL=BAAI/bge-m3
# 재현 가능한 운영 배포에서는 Hugging Face commit hash를 지정한다.
PRODUCT_TEXT_MODEL_REVISION=
PRODUCT_EMBEDDING_VERSION=marqo-fashionSigLIP+bge-m3-v1
PRODUCT_INDEXER_DEVICE=auto
PRODUCT_INDEXER_BATCH_SIZE=32
# product-indexer → Django catalog 내부 API
# 예: https://api.example.com/api/v1/internal/catalog/product-embeddings
PRODUCT_CATALOG_API_URL=
# Django API와 GPU product-indexer에 동일한 별도 시크릿을 주입한다.
PRODUCT_INDEXER_INTERNAL_TOKEN=
PRODUCT_CATALOG_API_TIMEOUT_SECONDS=30
# 상시 worker 모드에서 작업이 없을 때의 catalog API 확인 주기
PRODUCT_INDEXER_POLL_SECONDS=10
# 최초 시도 이후 재시도 횟수. 2이면 총 3회 시도한다.
PRODUCT_INDEXER_MAX_RETRIES=2
PRODUCT_INDEXER_RETRY_BASE_SECONDS=30
PRODUCT_INDEXER_STALE_JOB_MINUTES=30
# 하루 1회 drain 실행에서 짧은 재시도를 기다리는 최대 시간과 전체 실행 상한
PRODUCT_INDEXER_DRAIN_MAX_WAIT_SECONDS=120
PRODUCT_INDEXER_DRAIN_MAX_RUNTIME_MINUTES=120
PRODUCT_TEXT_MAX_LENGTH=512
PRODUCT_IMAGE_DOWNLOAD_TIMEOUT=30
PRODUCT_IMAGE_MAX_BYTES=20971520
PRODUCT_IMAGE_S3_BUCKET=
PRODUCT_IMAGE_S3_PREFIX=products

# collector → 외부 GPU product-indexer API 트리거
# URL이 비어 있으면 원격 트리거는 비활성화된다.
PRODUCT_INDEXER_TRIGGER_URL=
PRODUCT_INDEXER_TRIGGER_TOKEN=
PRODUCT_INDEXER_TRIGGER_TIMEOUT_SECONDS=10
PRODUCT_INDEXER_TRIGGER_MAX_RETRIES=2
PRODUCT_INDEXER_TRIGGER_RETRY_BASE_SECONDS=2
# GPU 서버 API bind 설정
PRODUCT_INDEXER_API_HOST=0.0.0.0
PRODUCT_INDEXER_API_PORT=8080

# S3 접근 자격증명 (EC2/RunPod에서 IAM 역할·프로파일이 없을 때만 설정)
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_DEFAULT_REGION=ap-southeast-2
# INDEXER_S3_BUCKET=skn28-cozy
# INDEXER_DEVICE=auto                # auto | cuda | cpu
# INDEXER_BATCH_SIZE=64
# INDEXER_EMBED_MODEL=hf-hub:Marqo/marqo-fashionSigLIP
# INDEXER_DOWNLOAD_WORKERS=8         # 이미지 다운로드 병렬 worker 수

# ---------- 기상청 APIHub (collector/weather) ----------
KMA_AUTH_KEY=
KMA_AUTH_PARAM_NAME=authKey
# MID_LAND_URL=
# MID_TEMP_URL=
# 격자→위경도 매핑 엑셀과 중기예보 구역 파일 (collector/weather 기준 상대경로)
GRID_FILE_PATH=data/동네예보지점좌표(위경도)_202601.xlsx
MID_LAND_AREA_FILE=data/mid_land_areas.json
MID_TEMP_AREA_FILE=data/mid_temp_areas.json
# 단기예보 격자 크기 (기상청 기본: 149x253)
KMA_NX_SIZE=149
KMA_NY_SIZE=253
# 격자 텍스트의 Y축 순서 반전 여부
Y_REVERSE=false
# 예보 수집 범위 (시간 단위)
VERY_SHORT_FORECAST_HOURS=6
SHORT_FORECAST_HOURS=72
SHORT_FORECAST_STEP_HOURS=3
# 수집할 예보 변수 목록 (콤마 구분)
NOWCAST_VARS=T1H,PTY,RN1,REH,WSD,VEC
VERY_SHORT_VARS=T1H,SKY,PTY,RN1,REH,WSD,VEC
SHORT_VARS=TMP,TMN,TMX,SKY,PTY,POP,PCP,REH,WSD,VEC

# ---------- 공통 ----------
# ---------- Gemini 코디 평가 ----------
# 실제 키는 커밋하지 않고 AWS Secrets Manager/SSM 또는 로컬 .env로 주입한다.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash
GEMINI_API_BASE_URL=https://generativelanguage.googleapis.com
# 사진 base64 업로드 시간이 포함되므로 넉넉히 잡는다 (전송본은 1024px로 축소해서 보냄)
GEMINI_TIMEOUT_SECONDS=60
# 평가한 코디 원본 사진 버킷 (비공개 + presigned GET). 비우면 옷장 버킷(WARDROBE_S3_BUCKET)을
# 재사용하고, 둘 다 비어 있으면 업로드를 건너뛴다 (평가·DB 기록은 정상 동작).
OUTFIT_S3_BUCKET=
# 코디 사진 presigned GET URL 유효기간 (초)
OUTFIT_PRESIGNED_GET_TTL=3600
# S3 업로드는 사용자 요청을 붙잡는 동기 구간이라 짧게 끊는다 (boto3 기본은 60s x 5회 재시도).
# 사진 업로드는 실패해도 접수를 503으로 거절할 뿐이라 오래 매달릴 이유가 없다.
OUTFIT_S3_CONNECT_TIMEOUT=5
OUTFIT_S3_READ_TIMEOUT=15
# --- 코디 평가 비동기 처리 (접수 API ↔ outfit-worker) ---
# 비로그인 접수 건은 analysis_id(UUID)를 아는 사람이 조회한다. 무기한 열어두지 않는다.
OUTFIT_ANON_TTL_HOURS=24
# 익명 접수 건의 소유권 이전(claim) 허용 시간(분). 조회(24h)보다 훨씬 짧게 잡는다 —
# claim은 쓰기이고 성공하면 사진·체형까지 열리는 권한 상승 경로다.
OUTFIT_CLAIM_TTL_MINUTES=60
# 한 번의 claim 요청에서 처리할 최대 건수
OUTFIT_CLAIM_MAX_ITEMS=20
# 워커가 죽어 방치된 QUEUED/PROCESSING 행을 FAILED로 정리하는 기준 (프론트 무한 폴링 방지)
OUTFIT_STALE_AFTER_MINUTES=5
# 접수·조회 응답에 실어 보내는 폴링 힌트 (프론트가 간격을 하드코딩하지 않게)
OUTFIT_POLL_AFTER_MS=2000
OUTFIT_ESTIMATED_SECONDS=30
# 평가 작업 큐 (REDIS_URL/REDIS_PASSWORD는 옷장 섹션과 공용)
OUTFIT_QUEUE_PENDING=outfit:analysis:pending
OUTFIT_QUEUE_PROCESSING=outfit:analysis:processing
OUTFIT_QUEUE_DEAD=outfit:analysis:dead
OUTFIT_QUEUE_RETRY=outfit:analysis:retry
OUTFIT_QUEUE_BLOCK_SEC=5
OUTFIT_QUEUE_MAX_RETRIES=3

# 골든셋 판단 지식 파일럿 (ml/golden_set)
# 사용자 코디 평가 GEMINI_MODEL과 분리하고 싶을 때만 GOLDEN_GEMINI_MODEL을 지정한다.
GOLDEN_GEMINI_MODEL=gemini-3.5-flash
GOLDEN_GEMINI_TIMEOUT_SECONDS=90
GOLDEN_FASHION_EMBED_MODEL=hf-hub:Marqo/marqo-fashionSigLIP
GOLDEN_TEXT_EMBED_MODEL=BAAI/bge-m3
GOLDEN_DEVICE=auto
GOLDEN_EMBED_BATCH_SIZE=16
# 이미지 분석 유료 호출 안전 상한. 10장 파일럿은 재검증 여유를 포함해 15회로 제한한다.
GOLDEN_MAX_MULTIMODAL_CALLS=15

# ----- 골든셋 임베딩 워커 (ml/golden_set) -----
# 원본 코디 사진은 이 버킷/prefix가 소유한다 (로컬 경로 아님).
GOLDEN_S3_BUCKET=
GOLDEN_S3_SOURCE_PREFIX=goldenset/source
# 아이템 이미지·완료 manifest가 쌓이는 곳. manifest.json 존재 = 처리 완료.
GOLDEN_S3_OUTPUT_PREFIX=goldenset/derived
# 선택. 스타일·계절·TPO 메타데이터 CSV 키 (비우면 메타데이터 없이 진행)
GOLDEN_S3_METADATA_KEY=
GOLDEN_DATASET_NAME=team-golden
GOLDEN_DATASET_VERSION=v1
# 골든셋 공개 상태. 검수 중에는 PILOT, 운영 추천에 노출할 때는 ACTIVE.
# ⚠️ 이 값은 적재 시점에 Qdrant payload(status·dataset_status)로 굳는다.
# 채팅이 조회할 때 쓰는 CHAT_GOLDENSET_DATASET_STATUSES와 **반드시 겹쳐야**
# 하며, 어긋나면 골든 코디 검색이 항상 0건이 되어 채팅이 답변 없이 실패한다
# (GOLDEN_OUTFIT_NOT_FOUND). 이미 적재한 뒤 상태만 올리려면 재임베딩 없이
# api 컨테이너에서:
#   python manage.py set_goldenset_qdrant_status #       --dataset-version v1 --status ACTIVE --from-status PILOT
GOLDEN_DATASET_STATUS=PILOT
# 아이템 분리 파이프라인 (image-processor 레지스트리 키). 비우면 WORKER_PIPELINE.
GOLDEN_ITEM_PIPELINE=gemini-edit
# 아이템 임베딩에 찍을 버전 라벨. 비우면 image-processor의
# WARDROBE_EMBEDDING_VERSION(옷장 이름표)이 골든 아이템에 그대로 찍힌다.
GOLDEN_EMBEDDING_VERSION=golden-fashionsiglip-v1
# 임베딩 후 Qdrant 적재까지 자동으로 이어갈지
GOLDEN_AUTO_INDEX=1
# 0이면 1회 처리 후 종료(배치), 양수면 그 간격(초)으로 상주 스캔
GOLDEN_SCAN_INTERVAL_SECONDS=0
# 골든 원본을 사용자 응답에 노출할지. 이미지별 original_exposable과 AND로 판정한다.
GOLDEN_ANCHOR_EXPOSABLE=0

# ----- 골든셋 확인용 웹 (docker-compose.golden_set.yml) -----
# api(8000)·product-indexer(8080)와 같은 호스트에서 도므로 포트를 분리한다.
# 컨테이너 내부 포트는 8081 고정, 아래 값은 호스트 노출 포트다.
GOLDEN_WEB_HOST_PORT=8081
# 비우면 무인증으로 뜬다. 사설망 밖에 노출한다면 반드시 채울 것.
GOLDEN_WEB_TOKEN=
# 1이면 웹에서 스캔을 직접 돌릴 수 있다. 기본은 읽기 전용(임베딩은 GPU 스택 몫).
GOLDEN_WEB_ALLOW_SCAN=0

# ---------- 공통 ----------
LOG_LEVEL=INFO
REQUEST_TIMEOUT=30

# ---------- 이메일 인증 ----------
# 로컬 기본값은 Django 콘솔 출력. 운영에서는 SMTP backend와 자격증명을 주입한다.
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=true
DEFAULT_FROM_EMAIL=COZY <no-reply@example.com>
EMAIL_VERIFICATION_CODE_TTL_SECONDS=600
EMAIL_VERIFICATION_RESEND_SECONDS=60
EMAIL_VERIFICATION_MAX_ATTEMPTS=5
COLLECTOR_MAX_RETRIES=3
# 실패 재시도 대기 초. 미설정 시 collector별 기본값 사용 (naver/eleven: 10, weather: 300)
# COLLECTOR_RETRY_DELAY_SECONDS=
# collector 스케줄러가 다음 실행 시각을 확인하는 주기 (초)
SCHEDULER_POLL_SECONDS=30

# ---------- 옷장 (wardrobe API) ----------
# 아이템 이미지 버킷 (원본·크롭). 비공개 버킷 + presigned GET 제공
WARDROBE_S3_BUCKET=
WARDROBE_REINDEX_QUEUE=wardrobe:reindex
# GPU 재인덱싱 워커가 호출할 내부 API 전체 URL
# 예: https://api.example.com/api/v1/internal/wardrobe/reindex-callback/
WARDROBE_REINDEX_CALLBACK_URL=
AWS_REGION=ap-northeast-2
REFERENCE_RECOMMENDATION_LOG_GROUP=
REFERENCE_RECOMMENDATION_QUERY_LIMIT=10000
# 옷장·캘린더 이미지 프로세서 job 큐 (Redis 리스트)
REDIS_URL=redis://localhost:6379/0
# (필수) Redis requirepass 비밀번호 (Infisical: REDIS_PASSWORD)
# docker-compose redis 서비스(--requirepass)와 클라이언트(api/worker)가 같이 쓴다.
# URL에 비밀번호를 넣지 않고 이 변수로 주입한다 (URL에 넣으면 URL 쪽이 우선)
REDIS_PASSWORD=

# ---------- 대화형 추천 채팅 ----------
CHAT_GUEST_TTL_DAYS=7
CHAT_GUEST_COOKIE_NAME=fashion_guest_chat
CHAT_GUEST_COOKIE_SECURE=true
# 로컬 HTTP는 Secure=false + Lax, 서로 다른 사이트의 운영 웹/API는 Secure=true + None 권장.
CHAT_GUEST_COOKIE_SAMESITE=Lax
# 채팅 사진용 비공개 버킷. 비우면 WARDROBE_S3_BUCKET을 재사용한다.
CHAT_ATTACHMENT_S3_BUCKET=
CHAT_ATTACHMENT_MAX_MB=15
CHAT_ATTACHMENT_PRESIGNED_GET_TTL_SECONDS=3600
CHAT_ATTACHMENT_S3_CONNECT_TIMEOUT_SECONDS=5
CHAT_ATTACHMENT_S3_READ_TIMEOUT_SECONDS=15
# 무드 분석용 이미지 최대 변 길이와 OpenAI 이미지 detail (low/high/auto)
CHAT_MOOD_IMAGE_MAX_EDGE_PX=1024
CHAT_MOOD_IMAGE_DETAIL=low
CHAT_OPENAI_MODEL=gpt-4o-mini
CHAT_OPENAI_TIMEOUT_SECONDS=30
CHAT_OPENAI_MAX_OUTPUT_TOKENS=1200
CHAT_PROMPT_VERSION=chat-orchestrator-v1
# 스타일리스트 말투 변환 제공자는 서버에서 하나만 선택한다. 사용자 선택 기능이 아니다.
# gemini 선택 시 실패해도 OpenAI로 전환하지 않고 규칙 템플릿을 사용한다.
PERSONA_LLM_PROVIDER=openai
PERSONA_LLM_MODEL=gpt-4o-mini
PERSONA_LLM_TIMEOUT_SECONDS=30
PERSONA_LLM_MAX_OUTPUT_TOKENS=400
PERSONA_LLM_PROMPT_VERSION=persona-narration-v1
# 운영 골든셋 버전과 공개 상태. 배포 시 반드시 실제 적재값으로 지정한다.
# 두 값 모두 Qdrant에 **실제로 들어 있는 값**과 정확히 같아야 한다. 리트리버가
# must 조건으로 걸기 때문에 하나라도 어긋나면 후보가 0건이 되고, 채팅은 답변을
# 만들지 못한 채 FAILED로 끝난다. 적재값 확인·대조는:
#   python manage.py check_chat_recommend
# 비워 두면 필터 자체가 빠져 전 버전·전 상태가 섞여 나온다 (로컬 전용).
CHAT_GOLDENSET_DATASET_VERSION=
CHAT_GOLDENSET_DATASET_STATUSES=ACTIVE
CHAT_PRODUCT_INDEX_VERSION=
CHAT_CONTEXT_RECENT_MESSAGES=12
CHAT_SUMMARY_TRIGGER_MESSAGES=24
CHAT_CONTEXT_CACHE_TTL_SECONDS=900
CHAT_MESSAGE_MAX_CHARS=4000
CHAT_QUEUE_BLOCK_SECONDS=5
CHAT_QUEUE_MAX_RETRIES=3
CHAT_QUEUE_ORPHAN_AGE_SECONDS=30
CHAT_SSE_BLOCK_MILLISECONDS=15000
CHAT_SSE_RETRY_MILLISECONDS=3000

# ---------- 추천 카드 혼합 출처 이미지 렌더 ----------
OUTFIT_RENDER_ENABLED=true
# 이미지 생성 백엔드: gemini(기본) | openrouter
# gemini는 GEMINI_API_KEY를, openrouter는 OPENROUTER_API_KEY를 쓴다.
OUTFIT_RENDER_BACKEND=gemini
OUTFIT_RENDER_GEMINI_MODEL=gemini-3.1-flash-image
OUTFIT_RENDER_GEMINI_URL=https://generativelanguage.googleapis.com/v1beta/interactions
# Gemini는 출력 형식으로 JPEG만 받는다.
OUTFIT_RENDER_GEMINI_MIME_TYPE=image/jpeg
# 아래 두 값은 openrouter 백엔드와 가상 착장(virtual try-on)이 쓴다.
OUTFIT_RENDER_MODEL=qwen/qwen-image-3-pro
OUTFIT_RENDER_URL=https://openrouter.ai/api/v1/images
OUTFIT_RENDER_ASPECT_RATIO=9:16
OUTFIT_RENDER_RESOLUTION=1K
OUTFIT_RENDER_TIMEOUT_SECONDS=180
OUTFIT_RENDER_MAX_REFERENCES=8
OUTFIT_RENDER_WARDROBE_BUCKET=
OUTFIT_RENDER_PRODUCT_BUCKET=
OUTFIT_RENDER_GOLDENSET_BUCKET=
OUTFIT_RENDER_RESULT_BUCKET=
OUTFIT_RENDER_RESULT_PREFIX=outfit-renders/v1
OUTFIT_RENDER_PRESIGNED_GET_TTL_SECONDS=3600
VIRTUAL_TRY_ON_RESULT_PREFIX=virtual-try-on/v1
VIRTUAL_TRY_ON_MAX_PERSON_IMAGE_BYTES=15728640
OUTFIT_RENDER_QUEUE_MAX_RETRIES=3
OUTFIT_RENDER_CACHE_TTL_SECONDS=604800
OUTFIT_RENDER_SSE_BLOCK_MILLISECONDS=15000
WARDROBE_JOB_QUEUE=wardrobe:jobs
WARDROBE_ITEM_JOB_QUEUE=wardrobe:item-jobs
WARDROBE_BATCH_MAX_ITEMS=30
WARDROBE_BATCH_MAX_TOTAL_MB=100
WARDROBE_BATCH_POLL_AFTER_MS=3000
WARDROBE_BATCH_SECONDS_PER_ITEM=8
WARDROBE_BATCH_STALE_AFTER_MINUTES=20
# 프로세서가 처리 완료 시 호출할 콜백 주소 (메인 API 외부 URL)
WARDROBE_CALLBACK_URL=http://localhost:8000/api/v1/internal/wardrobe/callback/
# 옷장·캘린더 콜백 인증용 공유 시크릿 (X-Internal-Token 헤더)
# API와 이미지 프로세서에 반드시 같은 값을 주입하며, 미설정 시 콜백은 차단된다.
WARDROBE_INTERNAL_TOKEN=
# 옷장 벡터 컬렉션은 위 Qdrant 공통 계약의 QDRANT_WARDROBE_COLLECTION을 사용한다.
WARDROBE_EMBEDDING_VERSION=fashionsiglip-v1
# 아이템 이미지 presigned GET URL 유효기간 (초)
WARDROBE_PRESIGNED_GET_TTL=3600
# 옷장 벡터 차원 (모델 교체 시에만 변경: FashionSigLIP=768, BGE-M3=1024)
WARDROBE_IMAGE_VECTOR_DIM=768
WARDROBE_TEXT_VECTOR_DIM=1024

# ---------- 신체치수 추정 (users API: /body/estimate, /body/photos) ----------
# 무사진 추정에 쓰는 joblib 경로. 미설정 시 ml/body_measurement/artifacts/models/
# hist_gradient_boosting.joblib 을 사용한다. AWS에서는 S3에서 받은 경로를 지정한다.
# ⚠️ 이 아티팩트는 scikit-learn 1.8.0으로 저장돼 있어 실행 환경도 1.8.0이어야 한다.
# BODY_MODEL_PATH=
# ml/ 디렉터리 위치 (추론 모듈 import 경로). 미설정 시 저장소 루트의 ml/ 사용
# ML_ROOT=
# 사진 기반 추정에 쓸 OpenRouter 멀티모달 모델
# Kimi K2.5 = validation 39명 평균 MAE 2.757cm로 1위 (호출당 약 $0.0045)
# 비용을 줄여야 하면 qwen/qwen3.7-flash (MAE 3.597cm, 호출당 약 $0.00015)
BODY_VLM_MODEL=moonshotai/kimi-k2.5
BODY_VLM_TIMEOUT_SECONDS=120
# OpenRouter API 키 (Infisical: OPENROUTER_API_KEY). 사진 기반 추정에만 필요
OPENROUTER_API_KEY=
# ---------- 캘린더 (style_calendar API) ----------
# 캘린더 원본과 연결된 옷장 아이템 스냅샷을 보관하는 비공개 버킷.
# 비워두면 WARDROBE_S3_BUCKET을 동일 버킷으로 사용한다.
CALENDAR_S3_BUCKET=
# 캘린더 이미지 presigned GET URL 유효기간 (초)
CALENDAR_PRESIGNED_GET_TTL=3600

# ---------- 룩북 (lookbook API) ----------
# 룩 사진과 연결된 옷장 아이템 스냅샷을 보관하는 비공개 버킷.
# 비워두면 CALENDAR_S3_BUCKET → WARDROBE_S3_BUCKET 순으로 대체한다.
LOOKBOOK_S3_BUCKET=
# 룩북 이미지 presigned GET URL 유효기간 (초)
LOOKBOOK_PRESIGNED_GET_TTL=3600
