# ============================================================
# GPU 서버(RunPod 등) 전용 환경변수 템플릿. 복사해서 사용: cp .env.gpu.example .env
# 기동: ./run-gpu.sh  (또는 docker compose -f docker-compose.gpu.yml up -d --build)
# 이 파일을 루트 .env로 두면 docker-compose.gpu.yml이 ${} 보간과 env_file 양쪽에서 읽는다.
# 대상: indexer/ (ETRI fashion-indexer, product-indexer, product-indexer-api)
#       image-processor/ (옷장·캘린더 이미지 프로세서)
# 실제 .env는 절대 커밋하지 않는다 (.gitignore 처리됨).
# 값 출처: indexer/old/config.py, indexer/product_indexer/product_config.py,
#          indexer/product_indexer/product_indexer_api.py, image-processor/config.py
# ============================================================

# ---------- 공통: AWS S3 자격증명 ----------
# boto3 표준 환경변수. EC2 IAM 역할/프로파일을 쓰면 비워둔다 (RunPod에서는 보통 필수).
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
# indexer(ETRI 데이터셋 버킷)는 ap-southeast-2, 옷장/상품 버킷은 ap-northeast-2 —
# 실제 사용하는 버킷 리전에 맞춘다.
AWS_DEFAULT_REGION=ap-southeast-2

# ---------- 공통: Qdrant 벡터 DB ----------
# GPU 서버에서 원격 Qdrant(EC2 등)로 적재하므로 외부 URL을 넣는다.
# 리버스 프록시(cloudflared/ALB/nginx) 뒤면 포트를 생략해도 되지만,
# 프록시가 없으면 포트를 반드시 명시한다 (예: http://10.0.1.5:6333).
# qdrant-client는 포트를 안 쓰면 6333을 붙이려 하는데, make_client가
# port=None으로 이를 막으므로 URL에 적힌 대로만 접속한다.
QDRANT_URL=http://localhost:6333
# 비우면 무인증(로컬 전용). 외부 노출된 Qdrant면 반드시 설정.
QDRANT_API_KEY=

# ---------- 공통: 로깅 ----------
LOG_LEVEL=INFO

# ---------- 공통: Hugging Face 모델 캐시 ----------
# docker-compose.gpu.yml은 HF_HOME=/app/.cache/huggingface + hf_cache 볼륨으로
# product-indexer와 image-processor가 모델 캐시를 공유한다(중복 다운로드 방지).
# Docker 이미지는 HF_HOME=/app/.cache/huggingface로 고정(Dockerfile).
# 베어메탈 실행 시 모델(FashionSigLIP ~0.8GB, bge-m3 ~2.3GB) 재다운로드를 피하려면
# 영속 볼륨 경로로 지정한다.
# HF_HOME=/workspace/.cache/huggingface

# ============================================================
# 1) indexer/old — ETRI 패션 코디 데이터셋 적재 (python -m old.fashion_indexer)
#    S3 원본 → FashionSigLIP 임베딩 → Qdrant fashion_items 컬렉션
# ============================================================

# ETRI 데이터셋 원본 S3 버킷
INDEXER_S3_BUCKET=skn28-cozy
# 11번 ETRI 패션 코디 데이터셋 프리픽스 (버킷 내 경로가 다르면 변경)
# INDEXER_ETRI11_PREFIX=11. 한국전자통신연구원_자율성장 인공지능 기술검증(PoC)을 위한 패션 코디 데이터셋/
# 메타데이터 파일명 (프리픽스 하위)
# INDEXER_ETRI11_MDATA_FILE=mdata.wst.txt.2020.6.23
# 적재 대상 컬렉션
QDRANT_COLLECTION=fashion_items
# 임베딩 모델 (open_clip 로드, 패션 도메인 특화)
INDEXER_EMBED_MODEL=hf-hub:Marqo/marqo-fashionSigLIP
# auto: cuda 가능하면 cuda, 아니면 cpu | cuda | cpu
INDEXER_DEVICE=auto
# 임베딩 배치 크기 (GPU VRAM에 맞춰 조정)
INDEXER_BATCH_SIZE=64
# S3 이미지 다운로드 병렬 worker 수
INDEXER_DOWNLOAD_WORKERS=8

# ============================================================
# 2) indexer — 네이버·11번가 상품 임베딩 worker (product_indexer.py)
#    catalog API → 이미지 S3 보존 → FashionSigLIP+bge-m3 → Qdrant products_v1
# ============================================================

# ----- Django catalog 내부 API -----
# GPU worker는 DB에 직접 연결하지 않고 아래 API로 작업과 상품 데이터를 주고받는다.
PRODUCT_CATALOG_API_URL=https://api.example.com/api/v1/internal/catalog/product-embeddings
# Django API와 GPU worker에 동일한 별도 시크릿을 주입한다.
PRODUCT_INDEXER_INTERNAL_TOKEN=
PRODUCT_CATALOG_API_TIMEOUT_SECONDS=30

# ----- 임베딩 모델 -----
PRODUCT_IMAGE_EMBED_MODEL=hf-hub:Marqo/marqo-fashionSigLIP
PRODUCT_TEXT_EMBED_MODEL=BAAI/bge-m3
# 재현 가능한 운영 배포에서는 Hugging Face commit hash를 지정한다.
PRODUCT_TEXT_MODEL_REVISION=
# Qdrant payload에 기록되는 임베딩 버전 태그 (비우면 기동 실패)
PRODUCT_EMBEDDING_VERSION=marqo-fashionSigLIP+bge-m3-v1
# 미설정 시 INDEXER_DEVICE 값을 따른다. auto | cuda | cpu
PRODUCT_INDEXER_DEVICE=auto
# bge-m3 텍스트 토큰 최대 길이
PRODUCT_TEXT_MAX_LENGTH=512

# ----- Qdrant 컬렉션 (ETRI fashion_items와 분리) -----
# 쇼핑몰별로 컬렉션을 나눈다. 벡터 구성은 같지만 검색·재색인·삭제를 독립적으로
# 하려고 분리했다. 두 값이 같으면 worker가 기동 시 실패한다.
PRODUCT_NAVER_QDRANT_COLLECTION=products_naver_v1
PRODUCT_ELEVEN_QDRANT_COLLECTION=products_eleven_v1

# ----- S3 상품 이미지 보존 -----
# (필수) 임베딩 전에 상품 이미지를 보존할 버킷. 비어 있으면 기동 실패.
# 버킷은 하나를 공유하고 prefix로 쇼핑몰을 나눈다.
PRODUCT_IMAGE_S3_BUCKET=
# 쇼핑몰별 prefix의 공통 뿌리. 아래 개별 prefix를 지정하지 않으면
# "{PRODUCT_IMAGE_S3_PREFIX}/{source}"가 되어 기존 키 규칙과 동일하다.
PRODUCT_IMAGE_S3_PREFIX=products
PRODUCT_NAVER_IMAGE_S3_PREFIX=products/naver
PRODUCT_ELEVEN_IMAGE_S3_PREFIX=products/eleven
# 최종 키: {prefix}/{외부상품ID}/{sha256}.jpg
# 원본 이미지 다운로드 타임아웃(초) / 최대 허용 크기(바이트, 20MB)
PRODUCT_IMAGE_DOWNLOAD_TIMEOUT=30
PRODUCT_IMAGE_MAX_BYTES=20971520

# ----- worker 실행 파라미터 -----
PRODUCT_INDEXER_BATCH_SIZE=32
# 상시 worker 모드에서 작업이 없을 때의 catalog API 확인 주기(초)
PRODUCT_INDEXER_POLL_SECONDS=10
# 이미지 다운로드·S3 입출력 병렬 스레드 수. 한 배치에 naver와 eleven 작업이
# 섞여 있어도 서로를 기다리지 않고 동시에 처리된다 (GPU 임베딩은 배치로 1회).
PRODUCT_INDEXER_IMAGE_WORKERS=8
# 최초 시도 이후 재시도 횟수. 2이면 총 3회 시도한다.
PRODUCT_INDEXER_MAX_RETRIES=2
# 재시도 대기 기본(초) — 지수 백오프의 밑
PRODUCT_INDEXER_RETRY_BASE_SECONDS=30
# processing 상태로 방치된 작업을 회수하는 기준(분)
PRODUCT_INDEXER_STALE_JOB_MINUTES=30
# 하루 1회 drain 실행에서 짧은 재시도를 기다리는 최대 시간(초)과 전체 실행 상한(분)
PRODUCT_INDEXER_DRAIN_MAX_WAIT_SECONDS=120
PRODUCT_INDEXER_DRAIN_MAX_RUNTIME_MINUTES=120

# ----- product-indexer-api (collector가 원격 트리거하는 HTTP 서버) -----
# (필수) 트리거 인증 토큰 — collector 쪽 PRODUCT_INDEXER_TRIGGER_TOKEN과 동일 값
PRODUCT_INDEXER_TRIGGER_TOKEN=
# GPU 서버 API bind 설정.
# compose로 띄우면 컨테이너 안 bind는 0.0.0.0:8080으로 고정되고,
# 호스트 노출 포트만 PRODUCT_INDEXER_API_HOST_PORT로 조정한다.
PRODUCT_INDEXER_API_HOST=0.0.0.0
PRODUCT_INDEXER_API_PORT=8080
PRODUCT_INDEXER_API_HOST_PORT=8080

# ============================================================
# 3) image-processor — 옷장·캘린더 이미지 프로세서
#    각 도메인의 Redis 큐 → 이미지 처리 → S3 → 메인 API 콜백
# ============================================================

# ----- Redis 큐 (메인 API와 같은 Redis·같은 키를 바라봐야 한다) -----
# GPU 서버에는 redis 컨테이너가 없다. AWS 쪽 Redis의 외부 주소를 넣는다
# (compose 서비스명 `redis`는 이 스택에서 해석되지 않는다).
REDIS_URL=redis://localhost:6379/0
# requirepass 비밀번호. URL에 비밀번호를 내장하지 않고 이 값으로 별도 주입한다.
REDIS_PASSWORD=
# pending 큐 키 (processing/dead/retries 키는 여기서 파생)
WARDROBE_JOB_QUEUE=wardrobe:jobs
# job 재시도 한도 (초과 시 dead 큐로 이동)
WORKER_MAX_RETRIES=3
# 큐 BLMOVE 블로킹 대기(초)
WORKER_QUEUE_BLOCK_SEC=5

# ----- 메인 API 콜백 -----
# (필수) 옷장 callback 인증 시크릿 (X-Internal-Token) — api와 동일 값
WARDROBE_INTERNAL_TOKEN=
# 큐 페이로드에 callback_url이 없을 때만 쓰는 폴백 URL (메인 API 외부 주소)
WARDROBE_CALLBACK_URL=
WORKER_CALLBACK_RETRIES=3
# 콜백 HTTP 타임아웃(초)
WORKER_CALLBACK_TIMEOUT=15

# ----- 파이프라인 선택 -----
# pipeline/__init__.py 레지스트리 키 (예정: sam3-crop)
WORKER_PIPELINE=gemini-edit
WORKER_QWEN_MODEL=Qwen/Qwen3-VL-8B-Instruct
WORKER_QWEN_MAX_NEW_TOKENS=768
WORKER_QWEN_MIN_PIXELS=200704
WORKER_QWEN_MAX_PIXELS=802816
WORKER_ITEM_NORMALIZE_MAX_PX=1024
# manifest에 기록되는 파이프라인 버전 태그
WORKER_PIPELINE_VERSION=gemini-edit-v1

# ----- Gemini (열거·생성·태깅 공용) -----
# (필수) Google AI Studio API 키
GEMINI_API_KEY=
GOLDEN_GEMINI_MODEL=gemini-3.5-flash
GOLDEN_GEMINI_TIMEOUT_SECONDS=90
GOLDEN_FASHION_EMBED_MODEL=hf-hub:Marqo/marqo-fashionSigLIP
GOLDEN_TEXT_EMBED_MODEL=BAAI/bge-m3
GOLDEN_DEVICE=auto
GOLDEN_EMBED_BATCH_SIZE=16
GOLDEN_MAX_MULTIMODAL_CALLS=15

# ----- 골든셋 임베딩 워커 (ml/golden_set) -----
# 원본 코디 사진은 이 버킷/prefix가 소유한다 (로컬 경로 아님).
GOLDEN_S3_BUCKET=
GOLDEN_S3_SOURCE_PREFIX=goldenset/source
# 아이템 이미지·완료 manifest가 쌓이는 곳. manifest.json 존재 = 처리 완료.
GOLDEN_S3_OUTPUT_PREFIX=goldenset/derived
# 선택. 스타일·계절·TPO 메타데이터 CSV 키 (비우면 메타데이터 없이 진행)
GOLDEN_S3_METADATA_KEY=
GOLDEN_DATASET_NAME=team-golden
GOLDEN_DATASET_VERSION=v1
# 아이템 분리 파이프라인 (image-processor 레지스트리 키). 비우면 WORKER_PIPELINE.
GOLDEN_ITEM_PIPELINE=gemini-edit
# 아이템 임베딩에 찍을 버전 라벨. 비우면 image-processor의
# WARDROBE_EMBEDDING_VERSION(옷장 이름표)이 골든 아이템에 그대로 찍힌다.
GOLDEN_EMBEDDING_VERSION=golden-fashionsiglip-v1
# 임베딩 후 Qdrant 적재까지 자동으로 이어갈지
GOLDEN_AUTO_INDEX=1
# 0이면 1회 처리 후 종료(배치), 양수면 그 간격(초)으로 상주 스캔
GOLDEN_SCAN_INTERVAL_SECONDS=0
# 골든 원본을 사용자 응답에 노출할지. 이미지별 original_exposable과 AND로 판정한다.
GOLDEN_ANCHOR_EXPOSABLE=0

# 참고: GOLDEN_WEB_* 는 API 서버 스택(docker-compose.golden_set.yml)에만
# 필요하다. GPU 스택에는 웹 서비스가 없어 여기서는 정의하지 않는다.
GEMINI_ENUM_MODEL=gemini-3.5-flash
GEMINI_TAG_MODEL=gemini-3.5-flash
# 상품 이미지 생성(편집) 모델
GEMINI_FLASH_IMAGE_MODEL=gemini-3.1-flash-image

# ----- 임베딩 (콜백 페이로드 → Qdrant 적재는 wardrobe-api 담당) -----
# 0이면 임베딩 생략(빈 벡터 → API가 재색인 대상으로 마킹)
WORKER_EMBED_ENABLED=1
WORKER_IMAGE_EMBED_MODEL=hf-hub:Marqo/marqo-fashionSigLIP
WORKER_TEXT_EMBED_MODEL=BAAI/bge-m3
# 콜백에 기록되는 임베딩 버전 — api의 WARDROBE_EMBEDDING_VERSION과 맞춘다
WARDROBE_EMBEDDING_VERSION=fashionsiglip-v1
# 임베딩용 디바이스. 비우면 cuda 가능 시 cuda (Gemini 호출과 무관)
DEVICE=
