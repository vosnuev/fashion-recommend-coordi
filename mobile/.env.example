# 앱 프론트 환경변수 예시 — 복사해서 .env 로 쓰고, .env 는 커밋하지 않는다.
#   cp .env.example .env
#
# EXPO_PUBLIC_ 접두사 값은 **앱 번들에 그대로 박히는 공개값**이다.
# (카카오 네이티브 앱 키 / 네이버·구글 Client ID 는 공개 식별자라 앱에 둬도 된다.
#  구글 client_secret 같은 진짜 비밀값은 백엔드 전용 — 여기에 절대 넣지 않는다.)
#
# ⚠️ 변수 이름은 src/constants/config.ts 가 읽는 이름과 **정확히 같아야 한다.**
#    이름이 어긋나면 앱은 조용히 기본값으로 돌아가서, 이유 없이 안 되는 것처럼 보인다.

# ── 백엔드 API 주소 ─────────────────────────────────────────
# 팀 dev 서버는 cloudflare 임시 터널이라 **주소가 수시로 바뀐다.** 최신 주소는 팀에 물어볼 것.
# 비워 두면 http://localhost:8000 으로 붙는다.
# 실기기에서 내 PC 의 백엔드에 붙일 땐 localhost 말고 PC 의 LAN IP 를 쓴다.
EXPO_PUBLIC_API_URL=

# ── 카카오 로그인 (네이티브 SDK) ────────────────────────────
# 카카오 개발자센터 > 앱 키 > **네이티브 앱 키** (REST API 키가 아니다).
EXPO_PUBLIC_KAKAO_NATIVE_APP_KEY=

# ── 카카오 공유 (웹) ────────────────────────────────────────
# 공유 옷장 초대를 카카오톡으로 보낼 때 웹에서 쓰는 **JavaScript 키**.
# 네이티브 앱 키와 값이 다르다 — 바꿔 넣으면 공유 창이 예외 없이 그냥 안 열린다.
# 추가로 카카오 개발자센터에서 아래 두 곳에 사용할 도메인을 모두 등록해야 한다.
# - 플랫폼 > Web > 사이트 도메인: 공유 SDK를 실행하는 주소(예: http://localhost:8081)
# - 제품 링크 관리 > 웹 도메인: 카드가 여는 주소(https://skn-1st-mobile.expo.app)
# 제품 링크 웹 도메인이 빠지면 카드는 전송돼도 모바일·PC의 링크가 동작하지 않을 수 있다.
# 네이티브(iOS/Android) 공유는 이 값 없이 네이티브 앱 키만으로 동작한다.
EXPO_PUBLIC_KAKAO_JAVASCRIPT_KEY=

# ── 공유 옷장 초대 링크 기준 주소 ───────────────────────────
# 초대 링크는 남에게 보내는 주소다. 비워 두면 배포본 주소를 쓴다.
# 로컬에서 만든 링크가 localhost 로 나가면 받는 사람 기기에서 아무것도 안 열린다 —
# 그래서 localhost·사설 IP 일 때는 자동으로 이 값으로 대체된다.
# 터널(https)로 데모할 땐 그 주소를 넣는다. 예) https://abcd-1234.ngrok.app
EXPO_PUBLIC_INVITE_BASE_URL=

# ── 네이버 로그인 (네이티브 SDK) ────────────────────────────
# 네이버 모바일 SDK 는 consumerSecret 을 앱에 내장하도록 요구한다(준공개값 취급).
# ⚠️ 같은 Key/Secret 을 백엔드 .env(NAVER_OAUTH_CLIENT_ID/SECRET)에도 넣어야 짝이 맞는다.
# URL_SCHEME 은 iOS 콜백용으로 우리가 정하는 값이며 app.json 플러그인 설정과 일치해야 한다.
EXPO_PUBLIC_NAVER_CONSUMER_KEY=
EXPO_PUBLIC_NAVER_CONSUMER_SECRET=
EXPO_PUBLIC_NAVER_URL_SCHEME=cozynaverlogin

# ── 구글 로그인 (네이티브 SDK) ──────────────────────────────
# WEB = Google Cloud "웹 애플리케이션" 클라이언트(백엔드가 토큰 검증할 때의 aud 기준),
# IOS = "iOS" 클라이언트. iOS Client ID 를 역순한 값이 app.json 의 iosUrlScheme 이어야 한다.
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=
EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=
