{
  "$comment": "VLM output schema does not return gender. Body API input/output gender is standardized as 'male' or 'female'; M/F is used only as an internal training encoding. Ratios are computed server-side from the returned lengths and must not be returned here.",
  "type": "object",
  "properties": {
    "photo_valid": { "type": "boolean" },
    "failure_reason": { "type": "string", "enum": ["none", "person_not_detected", "multiple_people", "head_not_visible", "face_not_visible", "feet_not_visible", "body_cropped", "invalid_front_pose", "invalid_side_pose", "low_image_quality"] },
    "front_person_count": { "type": "integer", "minimum": 0 },
    "side_person_count": { "type": "integer", "minimum": 0 },
    "front_head_visible": { "type": "boolean" },
    "side_head_visible": { "type": "boolean" },
    "front_face_visible": { "type": "boolean" },
    "side_face_visible": { "type": "boolean" },
    "front_feet_visible": { "type": "boolean" },
    "side_feet_visible": { "type": "boolean" },
    "front_full_body_visible": { "type": "boolean" },
    "side_full_body_visible": { "type": "boolean" },
    "front_pose_valid": { "type": "boolean" },
    "side_pose_valid": { "type": "boolean" },
    "image_quality_sufficient": { "type": "boolean" },
    "chest_cm": { "type": ["number", "null"] },
    "waist_cm": { "type": ["number", "null"] },
    "hip_cm": { "type": ["number", "null"] },
    "shoulder_cm": { "type": ["number", "null"] },
    "thigh_cm": { "type": ["number", "null"] },
    "calf_cm": { "type": ["number", "null"] },
    "arm_cm": { "type": ["number", "null"] },
    "thigh_length_cm": { "type": ["number", "null"] },
    "calf_length_cm": { "type": ["number", "null"] },
    "neck_length_cm": { "type": ["number", "null"] },
    "torso_length_cm": { "type": ["number", "null"] },
    "leg_length_cm": { "type": ["number", "null"] }
  },
  "required": [
    "photo_valid",
    "failure_reason",
    "front_person_count",
    "side_person_count",
    "front_head_visible",
    "side_head_visible",
    "front_face_visible",
    "side_face_visible",
    "front_feet_visible",
    "side_feet_visible",
    "front_full_body_visible",
    "side_full_body_visible",
    "front_pose_valid",
    "side_pose_valid",
    "image_quality_sufficient",
    "chest_cm",
    "waist_cm",
    "hip_cm",
    "shoulder_cm",
    "thigh_cm",
    "calf_cm",
    "arm_cm",
    "thigh_length_cm",
    "calf_length_cm",
    "neck_length_cm",
    "torso_length_cm",
    "leg_length_cm"
  ],
  "additionalProperties": false
}
